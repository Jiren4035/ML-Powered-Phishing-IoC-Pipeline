<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>AI Phishing & IoC Pipeline</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-gray-100 font-sans min-h-screen p-6">
    <div class="max-w-4xl mx-auto">
        <header class="mb-8 text-center">
            <h1 class="text-3xl font-bold text-blue-400">ML-Powered Phishing & IoC Pipeline</h1>
            <p class="text-gray-400 mt-2">Paste raw email content to evaluate risk via Machine Learning and extract IoCs.</p>
        </header>

        <div class="bg-gray-800 p-6 rounded-lg shadow-lg mb-8 border border-gray-700">
            <form method="POST">
                <label for="email_text" class="block text-sm font-medium mb-2 text-gray-300">Raw Email / Header Text</label>
                <textarea id="email_text" name="email_text" rows="6" class="w-full bg-gray-900 border border-gray-700 rounded p-3 text-gray-100 focus:outline-none focus:border-blue-500" placeholder="Paste suspicious email text here..."></textarea>
                <button type="submit" class="mt-4 bg-blue-600 hover:bg-blue-500 text-white font-medium py-2 px-4 rounded transition">Run ML Pipeline</button>
            </form>
        </div>

        {% if result %}
        <div class="bg-gray-800 p-6 rounded-lg shadow-lg border border-gray-700">
            <h2 class="text-xl font-semibold mb-4 text-blue-300 border-b border-gray-700 pb-2">Analysis Results</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                <div class="bg-gray-900 p-4 rounded border border-gray-700">
                    <span class="text-gray-400 text-sm">ML Phishing Probability:</span>
                    <p class="text-lg font-bold {% if result.risk_level == 'High' %}text-red-400{% elif result.risk_level == 'Medium' %}text-yellow-400{% else %}text-green-400{% endif %}">
                        {{ result.risk_level }} ({{ result.score }}%)
                    </p>
                </div>
            </div>

            <h3 class="text-lg font-semibold mb-3 text-gray-200">Extracted IoCs</h3>
            {% if result.iocs %}
                <div class="space-y-3">
                    {% for type, items in result.iocs.items() %}
