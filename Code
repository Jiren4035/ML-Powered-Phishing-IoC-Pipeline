                        <ul class="list-disc list-inside text-sm text-gray-300 mt-1">
                            {% for item in items %}
                            <li>{{ item }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                    {% endfor %}
                </div>
            {% else %}
                <p class="text-gray-400 text-sm">No indicators of compromise detected.</p>
            {% endif %}
